{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "voxelmill-ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["enable_request_signal"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.voxelmill.com",
      "custom_domain": true
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "vars": {
    "AI_PALETTE_ENABLED": "false",
    "AI_PALETTE_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "AI_DAILY_REQUEST_LIMIT": "100",
    "AI_REQUEST_DEADLINE_MS": "20000"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AI_DAILY_ALLOWANCE",
        "class_name": "AiDailyInferenceAllowance"
      }
    ]
  },
  "exports": {
    "AiDailyInferenceAllowance": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "ratelimits": [
    {
      "name": "CALLER_RATE_LIMITER",
      "namespace_id": "1401",
      "simple": {
        "limit": 8,
        "period": 60
      }
    },
    {
      "name": "EDGE_RATE_LIMITER",
      "namespace_id": "1402",
      "simple": {
        "limit": 40,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false,
      "persist": false
    },
    "traces": {
      "enabled": false,
      "persist": false
    }
  }
}
