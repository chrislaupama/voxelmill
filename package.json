{
  "name": "voxelmill",
  "private": true,
  "version": "0.1.0",
  "description": "Turn textured high-poly GLB models into palette-aware MagicaVoxel files.",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrislaupama/voxelmill.git"
  },
  "homepage": "https://voxelmill.com",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p workers/ai-api/tsconfig.json && wrangler deploy --dry-run --config workers/ai-api/wrangler.jsonc --outdir .wrangler/ai-api",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real-assets": "playwright test --config playwright.real-assets.config.ts",
    "check": "npm test && npm run build && npm run build:api && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:assets": "node scripts/verify-assets.mjs",
    "inventory:glb": "node scripts/inventory-glb.mjs",
    "cli": "tsx src/cli.ts",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler pages deploy dist --project-name voxelmill --branch main",
    "deploy:api": "npm run build:api && wrangler deploy --config workers/ai-api/wrangler.jsonc",
    "deploy:all": "npm run deploy:api && npm run deploy"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.10",
    "wrangler": "^4.110.0"
  }
}
